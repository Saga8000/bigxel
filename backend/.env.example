# development | staging | production
APP_ENV=development
# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://bigxel_app:CHANGE_ME@localhost:5432/bigxel
# Separate database used only by pytest (all tables are truncated between tests)
TEST_DATABASE_URL=postgresql+psycopg://bigxel_app:CHANGE_ME@localhost:5432/bigxel_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_DAYS=30
# Set to true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build password-reset links
FRONTEND_URL=http://localhost:5173
# simulated = fake wallet top-ups (development/staging only); razorpay = real payments; disabled = no top-ups
PAYMENTS_MODE=simulated
# Razorpay (Dashboard > Settings > API Keys). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<your-site>/api/payments/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Resend (resend.com > API Keys). Without a verified domain Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM=BigXel Ads <onboarding@resend.dev>
# local = backend/uploads; s3 = S3-compatible object storage such as Cloudflare R2
STORAGE_BACKEND=local
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev or your custom domain
S3_PUBLIC_BASE_URL=
PLATFORM_FEE_PERCENT=30
MAX_TOPUP_AMOUNT=100000
MAX_UPLOAD_MB=20
